    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "系統詢問行事曆權限時顯示的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LifeGame needs access to your calendar so it can add and manage your events."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定の追加と管理のために、LifeGame がカレンダーへアクセスします。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LifeGame 需要存取你的行事曆，以便新增和管理事件"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "系統詢問動態感應器權限時顯示的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LifeGame uses motion sensors to create the parallax effect on cards."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードの視差効果を表示するために、LifeGame がモーションセンサーを使用します。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LifeGame 使用動態感應器來產生卡片視差效果"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "系統詢問相簿權限時顯示的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LifeGame needs access to your photo library so you can add photos to your log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録に写真を追加できるように、LifeGame が写真ライブラリへアクセスします。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LifeGame 需要存取你的相簿，讓你為日誌加入照片"
          }
        }
      }
    }
